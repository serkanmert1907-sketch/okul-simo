{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "okul-simo",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_ROOMS", "class_name": "LiveRoom" },
      { "name": "ZOOM_SESSIONS", "class_name": "ZoomSessionDO" }
    ]
  },
  "r2_buckets": [
    { "binding": "LIVE_MEDIA", "bucket_name": "okul-simo-live-media" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveRoom", "ZoomSessionDO"] }
  ],
  "vars": {
    "ZOOM_SDK_VERSION": "6.2.0"
  }
}
